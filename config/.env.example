# =============================================================================
#  Maldonado Advogados - Variaveis de ambiente (TEMPLATE)
#  Copie este arquivo para  config/.env  e preencha com as credenciais DO
#  ESCRITORIO. NUNCA versione o .env real. Os valores comecam VAZIOS de proposito.
# =============================================================================

# -----------------------------------------------------------------------------
#  IDENTIDADE DO ESCRITORIO
# -----------------------------------------------------------------------------
ESCRITORIO_NOME=Maldonado Advogados
ESCRITORIO_ADVOGADO=Dr. Renan Gomes Maldonado de Jesus
ESCRITORIO_OAB=OAB/RO 5769
ESCRITORIO_ASSINATURA=Dr. Renan Gomes Maldonado de Jesus - OAB/RO 5769 - Porto Velho/RO
ESCRITORIO_CIDADE=Porto Velho - RO
CIDADE_FORO=Porto Velho
ESCRITORIO_ENDERECO=Rua Rafael Vaz e Silva, n. 1040, Bairro Nossa Senhora das Gracas, CEP 76.804-162, Porto Velho/RO
ESCRITORIO_TELEFONE=69 3223-5881
ESCRITORIO_EMAIL_RESPONSAVEL=maldonadoadvogadopvh@gmail.com

# -----------------------------------------------------------------------------
#  CREDENCIAIS / TOKENS  (preencher no onboarding)
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ADVBOX_API_TOKEN=
# Caminho do JSON de credenciais do Google Cloud (service account ou OAuth):
GOOGLE_APPLICATION_CREDENTIALS=config/credentials.json
GOOGLE_OAUTH_CREDENTIALS=config/oauth_credentials.json

# -----------------------------------------------------------------------------
#  GOOGLE DRIVE  - estrutura propria do escritorio (ZEUS)
#  Mantemos a convencao que o escritorio ja usa:
#  ZEUS > 03. CLIENTES > 01 CLIENTES > [LETRA] > [CLIENTE] > 4 subpastas
# -----------------------------------------------------------------------------
DRIVE_PASTA_ZEUS_ID=
DRIVE_PASTA_CLIENTES_ID=
# Timbrado isolado (so header/footer, sem conteudo de peca):
DOCS_MODELOS_TIMBRADO=DOCS_MODELOS/timbrado_modelo.docx
# Banco de teses (vault Obsidian) - Squad Jurimetria:
BASE_CONHECIMENTO_PATH=BASE_CONHECIMENTO/

# -----------------------------------------------------------------------------
#  USUARIOS ADVBOX  (IDs do painel ADVBOX > Usuarios - ver config/equipe.py)
# -----------------------------------------------------------------------------
ADVBOX_USER_RESPONSAVEL=
ADVBOX_USER_OUTRO_ADVOGADO=
ADVBOX_USER_CONTROLADORIA=
# Campo 'from' das tarefas /posts (quem assina a tarefa):
ADVBOX_USER_FROM=

# -----------------------------------------------------------------------------
#  DJEN/COMUNICA (CNJ)  - Squad Controladoria (prioridade)
# -----------------------------------------------------------------------------
# OABs monitoradas, separadas por virgula, formato NUMERO-UF (ex.: 5769-RO,13021-RO):
DJEN_OAB_LISTA=

# -----------------------------------------------------------------------------
#  AGENDA (Google Calendar) - eventos de prazo fatal
# -----------------------------------------------------------------------------
# E-mails da equipe que recebem convite de prazo, separados por virgula:
AGENDA_EMAILS_EQUIPE=
