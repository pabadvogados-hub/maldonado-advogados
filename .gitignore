# Segredos / credenciais - NUNCA versionar
config/.env
config/credentials.json
config/oauth_credentials.json
config/token.json
config/token*.json
config/*.bak
DOCS_MODELOS/timbrado_modelo.docx

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/

# Banco de teses: SO "00 - TEMAS" (conteudo juridico generico) vai pro
# repositorio publico. "01 - MAGISTRADOS", "02 - CASOS" e "04 - REFERENCIAS
# EXTERNAS" acumulam DADOS REAIS DE CLIENTES (nomes, processos, textos de
# decisao) via jurimetria.py - nunca podem ir pra um repo publico.
BASE_CONHECIMENTO/01 - MAGISTRADOS/**/*.md
BASE_CONHECIMENTO/02 - CASOS/*.md
BASE_CONHECIMENTO/04 - REFERENCIAS EXTERNAS/*.md
!BASE_CONHECIMENTO/**/.gitkeep

# Relatorios / saidas geradas (dados reais de processos/clientes - nunca versionar)
*.tmp
tmp/
logs/
# financeiro, laudos e relatorios gerados (dado real de cliente)
SAIDA/

# Arquivos pessoais do SO
Thumbs.db
.DS_Store
